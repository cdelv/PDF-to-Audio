[Desktop Entry]
Type=Application
Name=PDF to Audio
Comment=Turn documents into speech with a local Qwen voice
Exec=pdf-to-audio %F
Icon=io.github.pdftoaudio.Desktop
Terminal=false
StartupNotify=true
StartupWMClass=io.github.pdftoaudio.Desktop
Categories=AudioVideo;Audio;
MimeType=application/pdf;text/plain;text/markdown;text/x-rst;text/csv;
Keywords=PDF;TTS;Speech;Audiobook;Qwen;
